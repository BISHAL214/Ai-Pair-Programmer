{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "db:pull": "drizzle-kit introspect",
    "db:generate": "drizzle-kit generate:pg",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check:pg",
    "db:up": "drizzle-kit up:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "pnpm drizzle-kit studio --verbose"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.14.9",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.37.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7"
  }
}
